{
  "name": "@opto-sync/orm-plugins",
  "version": "0.2.1",
  "private": true,
  "description": "opto-sync ORM plugins (Drizzle, Kysely, TypeORM, Prisma) + integration tests",
  "scripts": {
    "typecheck": "npm run typecheck:stubs && npm run typecheck:real",
    "typecheck:stubs": "tsc -p tsconfig.json",
    "typecheck:real": "tsc -p tsconfig.real.json",
    "prisma:generate": "prisma generate --schema test/prisma-schema/schema.prisma",
    "pretest": "npm run typecheck",
    "test": "tsx test/run-all.ts",
    "test:drizzle": "tsx test/run-all.ts drizzle",
    "test:kysely": "tsx test/run-all.ts kysely",
    "test:typeorm": "tsx test/run-all.ts typeorm",
    "test:prisma": "tsx test/run-all.ts prisma"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-orm": "^0.38.3",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.19.2",
    "typeorm": "^0.3.20",
    "typescript": "^5.7.2"
  }
}
