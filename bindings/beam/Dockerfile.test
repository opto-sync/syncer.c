# Test image for the BEAM binding.
#
# Needs three toolchains in one place: Rust (Rustler NIF), a C compiler (the
# syncer.c core is compiled into syncer-rs by its build.rs), and Elixir/OTP.
# The official elixir images have no cargo, so start from Rust and add
# Elixir/OTP from Debian trixie (Elixir 1.18 / OTP 27).
#
#   docker build -f Dockerfile.test -t opto-sync-beam-test .
#   docker run --rm -v "$(git rev-parse --show-toplevel)":/src \
#     -w /src/bindings/beam opto-sync-beam-test \
#     sh -c 'mix deps.get && mix test'
FROM rust:1.97-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        elixir \
        erlang-dev \
        erlang-eunit \
        git \
    && rm -rf /var/lib/apt/lists/*

ENV MIX_HOME=/opt/mix \
    HEX_HOME=/opt/hex

RUN mix local.hex --force && mix local.rebar --force

# Compile and exercise the dedicated Gleam wrapper against this NIF too. Keep
# the compiler and checksum pinned so a language release cannot silently
# change CI output. Official releases are musl-static and work in this Debian
# image on both GitHub's amd64 runners and arm64 developer machines.
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64) gleam_arch=x86_64 ;; \
      arm64) gleam_arch=aarch64 ;; \
      *) echo "unsupported Gleam architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && gleam_asset="gleam-v1.16.0-${gleam_arch}-unknown-linux-musl.tar.gz" \
    && gleam_url="https://github.com/gleam-lang/gleam/releases/download/v1.16.0/${gleam_asset}" \
    && curl -fsSLO "$gleam_url" \
    && curl -fsSLO "${gleam_url}.sha256" \
    && sha256sum -c "${gleam_asset}.sha256" \
    && tar -xzf "$gleam_asset" -C /usr/local/bin gleam \
    && rm "$gleam_asset" "${gleam_asset}.sha256" \
    && gleam --version

WORKDIR /src/bindings/beam
