# Build artifacts
core/build/
bindings/typescript/build/
bindings/gleam/build/
bindings/typescript/node_modules/
bindings/sql/postgres/*.o
bindings/sql/postgres/*.so
bindings/sql/sqlite/opto_sync.so
bindings/sql/sqlite/opto_sync.dylib
bindings/sql/sqlite/opto_sync.dll
# ORM plugin integration-test dependencies (the generated Prisma client lands
# in node_modules/.prisma). The lockfile IS committed, matching
# bindings/typescript, so test runs are reproducible.
plugins/typescript/node_modules/
bindings/rust/target/
bindings/dart/.dart_tool/

# OS files
.DS_Store
*.swp
*.swo

# IDE
.vscode/
.idea/

# Rust build output anywhere
**/target/

# Dart tool caches anywhere
**/.dart_tool/
# Dart ORM adapters are library packages; resolver locks are generated locally
# and intentionally not versioned.
plugins/dart/*/pubspec.lock

# Compiled test binaries and debug symbols
core/test/test_syncer
core/test/prop_test
core/test/quick_test
core/test/*_asan
**/*.dSYM/

# Differential-harness generated artifacts
test-differential/corpus.jsonl
test-differential/corpus-pass2*.jsonl
test-differential/results-*.jsonl
test-differential/run_c
test-differential/go-runner/go-runner
test-differential/rust-runner/target/
test-differential/corpus2-*.jsonl
test-differential/results2-*.jsonl
test-differential/go-runner/run_go
test-differential/pubspec.lock

# Fuzzing campaign logs (libFuzzer writes these into CWD)
fuzz-*.log

# Zed deterministic package output
.zed/
